{
    "crons": [
        {
            "path": "/api/cron/daily-reminder",
            "schedule": "0 14,20 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!manifest\\.json|firebase-messaging-sw\\.js).*)",
            "destination": "/index.html"
        }
    ]
}